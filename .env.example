# Optional. Only needed if you run the local Node server instead of GitHub Pages.
# With a key here, the page uses it and never asks visitors for one.
# Get a key at https://fal.ai/dashboard/keys
FAL_KEY=

# Optional: port for the local server (default 3000)
PORT=3000

# Optional: override the fal.ai endpoints used by the local server
# SEEDANCE_MODEL=bytedance/seedance-2.5/reference-to-video
# NANO_BANANA_MODEL=fal-ai/nano-banana-pro
# NANO_BANANA_EDIT_MODEL=fal-ai/nano-banana-pro/edit
# VISION_ENDPOINT=openrouter/router/vision
# WHISPER_MODEL=fal-ai/whisper
# AUDIO_CONVERT_MODEL=fal-ai/ffmpeg-api/merge-audios
